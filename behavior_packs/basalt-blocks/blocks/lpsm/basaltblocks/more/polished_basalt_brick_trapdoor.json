{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_basaltblocks:polished_basalt_brick_trapdoor",
      "menu_category": {
        "category": "construction",
        "group": "itemGroup.name.trapdoor"
      },
      "states": {
        "lps:open": [false, true]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        },
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:vertical_half"]
        }
      }
    },
    "components": {
      "tag:stone": {},
      "minecraft:map_color": "#191919",
      "minecraft:loot": "loot_tables/basaltblocks/blocks/polished_basalt_brick_trapdoor.json",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.15
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 4.2
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 3, 16]
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 3, 16]
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "lpsm_basaltblocks:polished_basalt_brick_trapdoor"
        }
      },
      "minecraft:on_interact": {
        "event": "lps:on_interact"
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('lps:open')==true",
        "components": {
          "minecraft:geometry": "geometry.template_orientable_trapdoor_open",
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 16, 3]
          },
          "minecraft:collision_box": {
            "origin": [-8, 0, -8],
            "size": [16, 16, 3]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:vertical_half')=='bottom'&&q.block_state('lps:open')==false",
        "components": {
          "minecraft:geometry": "geometry.template_orientable_trapdoor_down"
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='north'&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='south'&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='east'&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='west'&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:vertical_half')=='top'&&q.block_state('lps:open')==false",
        "components": {
          "minecraft:geometry": "geometry.template_orientable_trapdoor_up"
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='north'&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:transformation": {
            "rotation": [180, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='south'&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:transformation": {
            "rotation": [180, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='east'&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:transformation": {
            "rotation": [180, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='west'&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:transformation": {
            "rotation": [180, -90, 0]
          }
        }
      }
    ],
    "events": {
      "lps:on_interact": {
        "run_command": {
          "target": "player",
          "command": "playsound use.basalt @p"
        },
        "set_block_state": {
          "lps:open": "!q.block_state('lps:open')"
        }
      }
    }
  }
}
