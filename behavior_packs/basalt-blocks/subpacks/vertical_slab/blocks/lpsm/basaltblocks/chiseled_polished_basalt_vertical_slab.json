{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_basaltblocks:chiseled_polished_basalt_vertical_slab",
      "states": {
        "lps:type": ["single", "double"]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      },
      "menu_category": {
        "category": "construction",
        "group": "itemGroup.name.stairs"
      }
    },
    "components": {
      "tag:stone": {},
      "minecraft:loot": "loot_tables/basaltblocks/blocks/chiseled_polished_basalt_vertical_slab.json",
      "minecraft:map_color": "#000000",
      "minecraft:light_dampening": 0,
      "minecraft:geometry": "geometry.template_vertical_slab",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.15
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 4.2
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "lpsm_basaltblocks:chiseled_polished_basalt"
        }
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, 0],
        "size": [16, 16, 8]
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, 0],
        "size": [16, 16, 8]
      },
      "minecraft:on_interact": {
        "condition": "q.block_state('lps:type') != 'double' && q.is_item_name_any('slot.weapon.mainhand','lpsm_basaltblocks:chiseled_polished_basalt_vertical_slab')",
        "event": "lps:on_interact"
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='north'&&q.block_state('lps:type')=='single'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='south'&&q.block_state('lps:type')=='single'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='east'&&q.block_state('lps:type')=='single'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction')=='west'&&q.block_state('lps:type')=='single'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('lps:type')=='double'",
        "components": {
          "minecraft:loot": "loot_tables/basaltblocks/blocks/basalt_pillar_double_vertical_slab.json",
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:selection_box": true,
          "minecraft:collision_box": true
        }
      }
    ],
    "events": {
      "lps:on_interact": {
        "decrement_stack": {},
        "set_block_state": {
          "lps:type": "'double'"
        },
        "run_command": {
          "target": "player",
          "command": "playsound use.basalt @p"
        }
      }
    }
  }
}
